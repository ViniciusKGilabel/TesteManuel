# Copy to .env and fill in your values before running docker-compose

# Required — used by fraud-sidecar (LangChain → Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database passwords (defaults match docker-compose.yml dev values)
POSTGRES_PASSWORD=postgres
MYSQL_ROOT_PASSWORD=root_pass

# WordPress admin credentials
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin_pass
WP_ADMIN_EMAIL=admin@example.com

# Apollo Federation Gateway subgraph URLs (optional — defaults match docker-compose service ports)
SUBGRAPH_AUTH_URL=http://auth-service:3001/graphql
SUBGRAPH_DOMAIN_URL=http://domain-service:3002/graphql
SUBGRAPH_ORDER_URL=http://order-service:3003/graphql
SUBGRAPH_WORDPRESS_URL=http://wordpress:8080/graphql
